{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_uptime_seconds{application=\"$application\"}",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Start Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "dateTimeAsIso" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_start_time_seconds{application=\"$application\"} * 1000",
          "legendFormat": "start",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU Usage (Process)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "max": 1, "min": 0, "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"$application\"}",
          "legendFormat": "process cpu",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU Usage (System)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "max": 1, "min": 0, "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "system_cpu_usage{application=\"$application\"}",
          "legendFormat": "system cpu",
          "refId": "A"
        }
      ]
    },
    {
      "title": "System CPU Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "system_cpu_count{application=\"$application\"}",
          "legendFormat": "cpus",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Open File Descriptors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_files_open_files{application=\"$application\"}",
          "legendFormat": "open",
          "refId": "A"
        },
        {
          "expr": "process_files_max_files{application=\"$application\"}",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },

    {
      "title": "JVM Memory",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "JVM Heap Memory Used vs Committed vs Max",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{application=\"$application\", area=\"heap\"})",
          "legendFormat": "heap committed",
          "refId": "B"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"$application\", area=\"heap\"})",
          "legendFormat": "heap max",
          "refId": "C"
        }
      ]
    },
    {
      "title": "JVM Non-Heap Memory Used vs Committed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"nonheap\"})",
          "legendFormat": "non-heap used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{application=\"$application\", area=\"nonheap\"})",
          "legendFormat": "non-heap committed",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM Heap Memory Pools",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"$application\", area=\"heap\"}",
          "legendFormat": "{{id}} used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"$application\", area=\"heap\"}",
          "legendFormat": "{{id}} committed",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM Non-Heap Memory Pools",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"$application\", area=\"nonheap\"}",
          "legendFormat": "{{id}} used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"$application\", area=\"nonheap\"}",
          "legendFormat": "{{id}} committed",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM Buffer Pools",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_buffer_memory_used_bytes{application=\"$application\"}",
          "legendFormat": "{{id}} used",
          "refId": "A"
        },
        {
          "expr": "jvm_buffer_total_capacity_bytes{application=\"$application\"}",
          "legendFormat": "{{id}} capacity",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM Buffer Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_buffer_count_buffers{application=\"$application\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Garbage Collection",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "GC Pause Duration (avg per minute)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[1m]) / rate(jvm_gc_pause_seconds_count{application=\"$application\"}[1m])",
          "legendFormat": "{{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GC Pause Rate (pauses/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{application=\"$application\"}[1m])",
          "legendFormat": "{{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GC Pause Total Time Spent (s/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[1m])",
          "legendFormat": "{{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GC Memory Allocated / Promoted",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_memory_allocated_bytes_total{application=\"$application\"}[1m])",
          "legendFormat": "allocated",
          "refId": "A"
        },
        {
          "expr": "rate(jvm_gc_memory_promoted_bytes_total{application=\"$application\"}[1m])",
          "legendFormat": "promoted",
          "refId": "B"
        }
      ]
    },
    {
      "title": "GC Live Data / Max Data Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_gc_live_data_size_bytes{application=\"$application\"}",
          "legendFormat": "live data",
          "refId": "A"
        },
        {
          "expr": "jvm_gc_max_data_size_bytes{application=\"$application\"}",
          "legendFormat": "max data",
          "refId": "B"
        }
      ]
