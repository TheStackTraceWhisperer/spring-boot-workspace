      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 99 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
