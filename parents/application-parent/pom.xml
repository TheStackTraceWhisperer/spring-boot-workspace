<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example</groupId>
    <artifactId>spring-boot-workspace</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>application-parent</artifactId>
  <packaging>pom</packaging>
  <name>application-parent</name>
  <description>Parent POM for application modules</description>

  <properties>
    <jacoco.skip>false</jacoco.skip>
  </properties>

  <!-- Import internal BOM for dependency management -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>internal-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Shared ArchUnit rules -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>archunit-rules</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ArchUnit (needed at test runtime; archunit-rules declares it as provided) -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Shared test fixtures (Testcontainers, base test classes) -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>test-fixtures</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
